# Statické súbory sa môžu uložiť, ale pred použitím sa vždy overí ich aktuálnosť.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|css|js|svg|png|jpg|jpeg|gif|webp|ico|woff2?)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# API cesty obsluhuje spoločný front controller.
RewriteEngine On
# Endpointy ako /api/me majú zároveň fyzický priečinok; vypnutie presmerovania na lomku
# umožní, aby požiadavku spracovalo pravidlo nižšie namiesto DirectorySlash.
DirectorySlash Off
RewriteRule ^api(?:/.*)?$ api/index.php [QSA,L]
